# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=4000
NODE_ENV=development
# Which websites may call the API from a browser (comma-separated)
CORS_ORIGINS=https://applyfields.com,https://applyfields-web-two.vercel.app,https://applyfields-admin.vercel.app,http://localhost:3000,http://localhost:3001

# ---------- Supabase Postgres ----------
# Supabase → Project Settings → Database → Connection string
# Developers: use YOUR login instead of "postgres", e.g. karthik_dev.<project-ref> (database/README.md)
# App traffic: Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma CLI only (`pnpm db:pull`): Session pooler / direct (port 5432). Never `prisma migrate`.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Supabase Storage (documents, notification PDFs) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket with the downloaded notification PDFs (same as apps/ingestion)
STORAGE_BUCKET=notifications

# ---------- Auth (generate each with: openssl rand -hex 32) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ---------- Talking to the Python ingestion service ----------
INGESTION_URL=http://localhost:8000
# Same value as in apps/ingestion/.env
INTERNAL_SERVICE_TOKEN=

# ---------- Email Sending (Resend) ----------
# Verify applyfields.com at resend.com/domains. You can then send from ANY address under @applyfields.com!
RESEND_API_KEY=

# Sign-in. Google: OAuth client IDs allowed to sign in (web, Android, iOS), comma-separated.
# Without it Google sign-in returns 503 — the API never trusts an email sent by the browser.
GOOGLE_CLIENT_ID=
# SMS codes via MSG91 (needs DLT approval). Empty = code only printed in the dev API console.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Passkeys (WebAuthn). RP ID = the citizen website's domain; a passkey only works on that domain
# and its subdomains. Origins = exact site URLs allowed to use passkeys (comma-separated).
# Dev defaults: localhost / http://localhost:3000. Prod: applyfields.com / https://applyfields.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=ApplyFields
EMAIL_FROM=ApplyFields <no-reply@applyfields.com>
EMAIL_HELP_FROM=ApplyFields Help Desk <help@applyfields.com>
EMAIL_SERVICES_FROM=ApplyFields Services <services@applyfields.com>
EMAIL_ADMIN_FROM=ApplyFields Admin <admin@applyfields.com>
# Links inside emails: the website (item pages) and this API (the unsubscribe link)
WEB_URL=http://localhost:3000
# Services app (bookings, acknowledgment slips) — used in "application filed" notification links
SERVICE_URL=http://localhost:3003
API_PUBLIC_URL=http://localhost:4000/api/v1
# SCHEDULERS=off stops every background timer (notifications, auto-close, link health, scraper
# scheduler). With more than one API instance, set it on the instances that serve traffic and leave
# it unset on exactly ONE worker instance, so the daily notifications are sent once.
SCHEDULERS=
# NOTIFICATIONS=off stops only the 15-minute reminder + daily-notification timer (always off in tests)
NOTIFICATIONS=

# ---------- Typesense Search (Optional - sub-10ms search) ----------
# If not configured, API automatically falls back to PostgreSQL full-text + trigram search
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# ---------- AI LLM Engine (Groq / Grok / Anthropic) ----------
# Groq / Grok API Key for Fieldy AI chatbot synthesis & guidance:
GROQ_API_KEY=
GROK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Or Anthropic Claude API:
ANTHROPIC_API_KEY=

# ---------- Web Push (VAPID W3C Standard - Session 16) ----------
# Generate your own keys anytime with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@applyfields.com


# ---------- Later (leave empty for now) ----------
# Queues (Upstash Redis) — not needed yet; reminders use a timer like auto-close
REDIS_URL=


# Rate limiting (on by default): 300 req/min per IP, 10/min on sign-in/code/register routes. RATE_LIMIT=off disables.
RATE_LIMIT=
# Admin website base URL, used in staff alert links (default https://applyfields-admin.vercel.app)
ADMIN_URL=
# Partner portal, for links in partner approve/reject notifications. Empty = https://applyfields.vercel.app
PARTNER_URL=
# Razorpay (session 14 payments). Test keys (rzp_test_...) work before company KYC. Empty = payments off (503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<api>/api/v1/payments/webhook, events: payment.captured, payment.failed,
# order.paid, subscription.*, refund.processed. The secret you type there goes here.
RAZORPAY_WEBHOOK_SECRET=
# Dashboard → Subscriptions → Plans: create "ApplyFields Plus", ₹50, monthly; paste its plan_... id.
RAZORPAY_PLUS_PLAN_ID=
# ApplyFields convenience fee added to bookings paid online, in paise (0 = none; e.g. 1000 = ₹10).
BOOKING_CONVENIENCE_FEE_PAISE=

# ---------- Document Vault (AES-256 GCM) ----------
# 32-byte Base64 key for encrypting stored citizen documents (generate: openssl rand -base64 32)
VAULT_MASTER_KEY=

