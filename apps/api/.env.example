# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=4000
NODE_ENV=development
# Which websites may call the API from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Supabase Postgres ----------
# Supabase → Project Settings → Database → Connection string
# Developers: use YOUR login instead of "postgres", e.g. karthik_dev.<project-ref> (database/README.md)
# App traffic: Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma CLI only (`pnpm db:pull`): Session pooler / direct (port 5432). Never `prisma migrate`.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Supabase Storage (documents, notification PDFs) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket with the downloaded notification PDFs (same as apps/ingestion)
STORAGE_BUCKET=notifications

# ---------- Auth (generate each with: openssl rand -hex 32) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ---------- Talking to the Python ingestion service ----------
INGESTION_URL=http://localhost:8000
# Same value as in apps/ingestion/.env
INTERNAL_SERVICE_TOKEN=

# ---------- Notifications (Session 08) ----------
# Email (Resend). The EMAIL_FROM domain must be verified at resend.com/domains.
# Without a key, emails fail and show as "failed" on the admin Notifications page; in-app still works.
RESEND_API_KEY=
EMAIL_FROM=ApplyFields <no-reply@applyfields.in>
# Links inside emails: the website (item pages) and this API (the unsubscribe link)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api/v1
# NOTIFICATIONS=off stops the 15-minute reminder + email timer (it is always off in tests)
NOTIFICATIONS=

# ---------- Typesense Search (Optional - sub-10ms search) ----------
# If not configured, API automatically falls back to PostgreSQL full-text + trigram search
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# ---------- AI Career Guidance (Claude API - Session 12) ----------
# Leave empty for smart grounded fallback; paste your Anthropic API key when ready
ANTHROPIC_API_KEY=

# ---------- Later (leave empty for now) ----------
# Queues (Upstash Redis) — not needed yet; reminders use a timer like auto-close
REDIS_URL=

