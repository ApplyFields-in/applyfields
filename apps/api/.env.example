# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=4000
NODE_ENV=development
# Which websites may call the API from a browser (comma-separated)
CORS_ORIGINS=https://applyfields.com,https://applyfields-web-two.vercel.app,https://applyfields-admin.vercel.app,http://localhost:3000,http://localhost:3001

# ---------- Supabase Postgres ----------
# Supabase → Project Settings → Database → Connection string
# Developers: use YOUR login instead of "postgres", e.g. karthik_dev.<project-ref> (database/README.md)
# App traffic: Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma CLI only (`pnpm db:pull`): Session pooler / direct (port 5432). Never `prisma migrate`.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Supabase Storage (documents, notification PDFs) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket with the downloaded notification PDFs (same as apps/ingestion)
STORAGE_BUCKET=notifications

# ---------- Auth (generate each with: openssl rand -hex 32) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# ---------- Talking to the Python ingestion service ----------
INGESTION_URL=http://localhost:8000
# Same value as in apps/ingestion/.env
INTERNAL_SERVICE_TOKEN=

# ---------- Email Sending (Resend) ----------
# Verify applyfields.com at resend.com/domains. You can then send from ANY address under @applyfields.com!
RESEND_API_KEY=

# Sign-in. Google: OAuth client IDs allowed to sign in (web, Android, iOS), comma-separated.
# Without it Google sign-in returns 503 — the API never trusts an email sent by the browser.
GOOGLE_CLIENT_ID=
# SMS codes via MSG91 (needs DLT approval). Empty = code only printed in the dev API console.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Passkeys (WebAuthn). RP ID = the citizen website's domain; a passkey only works on that domain
# and its subdomains. Origins = exact site URLs allowed to use passkeys (comma-separated).
# Dev defaults: localhost / http://localhost:3000. Prod: applyfields.com / https://applyfields.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=ApplyFields
EMAIL_FROM=ApplyFields <no-reply@applyfields.com>
EMAIL_SUPPORT_FROM=ApplyFields Support <support@applyfields.com>
EMAIL_HELP_FROM=ApplyFields Help Desk <help@applyfields.com>
EMAIL_SERVICES_FROM=ApplyFields Services <services@applyfields.com>
# Links inside emails: the website (item pages) and this API (the unsubscribe link)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api/v1
# NOTIFICATIONS=off stops the 15-minute reminder + email timer (it is always off in tests)
NOTIFICATIONS=

# ---------- Typesense Search (Optional - sub-10ms search) ----------
# If not configured, API automatically falls back to PostgreSQL full-text + trigram search
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# ---------- AI Career Guidance (Claude API - Session 12) ----------
# Leave empty for smart grounded fallback; paste your Anthropic API key when ready
ANTHROPIC_API_KEY=

# ---------- Web Push (VAPID W3C Standard - Session 16) ----------
# Generate your own keys anytime with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@applyfields.in


# ---------- Government DigiLocker / API Setu (National e-Governance Division) ----------
# Register your organization application at https://apisetu.gov.in or https://partners.digitallocker.gov.in
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:4000/api/v1/auth/digilocker/callback
DIGILOCKER_FRONTEND_URL=http://localhost:3000/account
DIGILOCKER_AUTHORIZE_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token

# ---------- Later (leave empty for now) ----------
# Queues (Upstash Redis) — not needed yet; reminders use a timer like auto-close
REDIS_URL=

