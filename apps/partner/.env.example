# Copy this file to .env.local. Variables starting with NEXT_PUBLIC_ are visible in the browser,
# so NEVER put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# "Sign in with Google" (same web client ID as the API's GOOGLE_CLIENT_ID). Empty = no Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
