{
  "expo": {
    "name": "ApplyFields Services",
    "slug": "applyfields-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "applyfields-services",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.applyfields.service"
    },
    "android": {
      "package": "in.applyfields.service",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "owner": "likhithkumar",
    "extra": {
      "eas": {
        "projectId": "f1a1ae13-f9a6-464d-841a-384c48330f65"
      }
    }
  }
}
