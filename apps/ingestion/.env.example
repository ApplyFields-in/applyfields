# Copy this file to .env and fill in real values. NEVER commit .env.

# Supabase → Project Settings → Database → Connection string (Session pooler, port 5432)
# Note the "+psycopg" part — needed by SQLAlchemy.
# Login: harsha_dev.<project-ref> while developing · ingestion_writer.<project-ref> for the real scraper
# (never the postgres password — see database/README.md)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Same value as INTERNAL_SERVICE_TOKEN in apps/api/.env (generate: openssl rand -hex 32)
INTERNAL_SERVICE_TOKEN=

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=notifications

# AI extraction (leave empty until we start AI extraction)
LLM_API_KEY=

USER_AGENT=ApplyFieldsBot/0.1 (+https://applyfields.in/bot)
CRAWL_DELAY_SECONDS=5
