{
  "expo": {
    "name": "ApplyFields Admin",
    "slug": "applyfields-admin",
    "scheme": "applyfields-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#082046",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "in.applyfields.admin",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.applyfields.admin",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ApplyFields Admin uses Face ID to unlock the staff desk on this phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f0f4f8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "likhithkumar",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3757945e-ae03-4ee5-93f8-9895bdc93bac"
      }
    }
  }
}
