# Copy to .env.local. EXPO_PUBLIC_* values are compiled into the app bundle,
# so never put a secret here.

# The NestJS API, including the /api/v1 prefix.
#   Android emulator  → http://10.0.2.2:4000/api/v1
#   iOS simulator     → http://localhost:4000/api/v1
#   A real phone      → http://<your-laptop-LAN-ip>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
