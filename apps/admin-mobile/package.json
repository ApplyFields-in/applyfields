{
  "name": "@applyfields/admin-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ApplyFields Admin app (Android + iOS) for staff — Expo Router",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "check": "node --no-warnings --experimental-strip-types src/lib/staff.check.ts"
  },
  "dependencies": {
    "@applyfields/types": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
