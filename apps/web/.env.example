# Copy this file to .env.local. Variables starting with NEXT_PUBLIC_ are visible in the browser,
# so NEVER put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Native Device OAuth 2.0 Client IDs (Google, Microsoft, Apple) ----------
# Google Cloud Console: OAuth 2.0 Web Client ID (Authorized Origin: http://localhost:3000, Redirect URI: http://localhost:3000/auth/callback)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft Entra / Azure Portal: Application (client) ID (Authorized redirect URI: http://localhost:3000/auth/callback)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Apple Developer: Services ID (client_id for Sign in with Apple)
NEXT_PUBLIC_APPLE_CLIENT_ID=
