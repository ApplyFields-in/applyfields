{
  "name": "applyfields",
  "private": true,
  "description": "ApplyFields - Every opportunity. One place.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@applyfields/web",
    "dev:admin": "turbo run dev --filter=@applyfields/admin",
    "dev:api": "turbo run dev --filter=@applyfields/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  }
}
